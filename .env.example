# Copy this file to .env (in backend/) and fill in real values.
# Never commit the real .env — it's covered by .gitignore.

# --- AWS (required) — from IAM: create an access key for a user/role
# with Transcribe Streaming permission ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# --- Slack (required) — from the Slack app's OAuth & Permissions page
# (bot token) and Basic Information page (signing secret) ---
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME

# --- LLM (required) — API key for the decision-detection / drafting
# model (Strands Agent or Claude) ---
LLM_API_KEY=REPLACE_ME

# --- Deepgram (optional) — fallback ASR provider, only needed if AWS
# Transcribe setup breaks. From the Deepgram console API keys page ---
DEEPGRAM_API_KEY=

# --- OpenSearch (optional) — not needed until phase 5 (P1); leave
# blank while SQLite covers decision history. From your OpenSearch
# domain's endpoint and master user credentials ---
OPENSEARCH_HOST=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# --- Detection tuning ---
CONFIDENCE_THRESHOLD=0.7
DEBOUNCE_WINDOW_SECONDS=12
