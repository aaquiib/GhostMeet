# Copy this file to .env (in backend/) and fill in real values.
# Never commit the real .env — it's covered by .gitignore.

# --- AWS (required) — from IAM: create an access key for a user/role
# with Transcribe Streaming permission. AWS Transcribe Streaming is the
# sole ASR provider — there is no fallback provider ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# --- Slack (required) — from the Slack app's OAuth & Permissions page
# (bot token) and Basic Information page (signing secret) ---
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME

# --- LLM (required) — API key for the decision-detection / drafting
# model (Strands Agent or Claude) ---
LLM_API_KEY=REPLACE_ME

# --- Postgres (required, no default) — must match docker-compose.yml's
# postgres service credentials for local dev: `docker compose up -d`
# (repo root) brings up a postgres:16 container with user/password/db
# all "ghost" on localhost:5432, matching the value below exactly. For
# a managed/hosted Postgres instance, point this at its connection
# string instead (still using the postgresql+asyncpg:// scheme) ---
DATABASE_URL=postgresql+asyncpg://ghost:ghost@localhost:5432/ghost

# --- OpenSearch (optional) — Postgres is the source of truth regardless;
# leave blank and /search falls back to a Postgres LIKE query
# automatically. For local dev: `docker compose up -d` (repo root),
# then OPENSEARCH_HOST=http://localhost:9200 with USER/PASSWORD left
# blank (the compose file disables the security plugin). For a managed
# domain, use its endpoint plus master user credentials ---
OPENSEARCH_HOST=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# --- Detection tuning ---
CONFIDENCE_THRESHOLD=0.7
DEBOUNCE_WINDOW_SECONDS=12
